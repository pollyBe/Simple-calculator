{
  "name": "calculator-simple",
  "scripts": {
    "start": "webpack serve --open --config ./webpack.config.js --env mode=dev",
    "build": "webpack",
    "dev": "webpack serve --env development",
    "prepare": "husky install",
    "lint": "eslint 'src/**/*.{js}'",
    "format": "prettier --write 'src/**/*.{js,json,md}'",
    "lint:fix": "eslint --fix 'src/**/*.{js}'"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "babel-loader": "^10.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-webpack-plugin": "^5.0.0",
    "globals": "^16.0.0",
    "html-webpack-plugin": "^5.6.3",
    "prettier": "^3.5.3",
    "prettier-loader": "^3.3.0",
    "sass": "^1.86.3",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "webpack": "^5.99.5",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.1"
  },
  "lint-staged": {
    "*.js": "eslint --cache --fix",
    "*.{js,css,md}": "prettier --write"
  }
}
